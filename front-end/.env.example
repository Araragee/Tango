# Copy to .env.local and fill in. Without these, the app runs in local demo mode.

# Supabase project URL and anon/publishable key (Dashboard › Project Settings › API).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# Web Push VAPID public key (the private key lives only in the dispatch_push
# edge function's secrets — never put it here).
VITE_VAPID_PUBLIC_KEY=

# Optional storage bucket overrides. Receipts must stay in a PRIVATE bucket
# (see supabase/migrations/022_private_receipts_bucket.sql).
# VITE_AVATARS_BUCKET=avatars
# VITE_RECEIPTS_BUCKET=receipts
